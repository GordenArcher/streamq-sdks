{
  "name": "streamq-js",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for the streamq message broker",
  "author": "Gorden Archer <gorden@goriaai.com>",
  "license": "MIT",
  "homepage": "https://github.com/GordenArcher/streamq-sdks",
  "repository": {
    "type": "git",
    "url": "https://github.com/GordenArcher/streamq-sdks"
  },
  "keywords": [
    "streamq",
    "message-broker",
    "pubsub",
    "websocket",
    "sse"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "eventsource": "^2.0.2"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "msw": "^2.3.0",
    "ws": "^8.17.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "@types/eventsource": "^1.1.15"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
